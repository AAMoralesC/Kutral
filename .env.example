# ==========================================================
# CONFIGURACIÓN DEL BOT KUTRAL
# Renombra este archivo a ".env" y coloca tus datos reales.
# ==========================================================

# Tu token de Discord (Obtenlo en Discord Developer Portal)
DISCORD_TOKEN=tu_token_de_discord_aqui

# Tu ID de Discord (clic derecho sobre tu nombre en Discord -> Copiar ID)
OWNER_ID=tu_id_de_discord_aqui

# --- Inteligencia Artificial ---
# Proveedor configurado: Groq
AI_PROVIDER=groq
AI_API_KEY=tu_api_key_de_groq_aqui
AI_MODEL=llama-3.3-70b-versatile

# --- Spotify (opcional, para integración de música en el futuro) ---
SPOTIFY_CLIENT_ID=opcional
SPOTIFY_CLIENT_SECRET=opcional
